# ──────────────────────────────────────────────────────────────────────────
# OmiAgent configuration. Copy to `.env` and fill what you have.
# Everything except "at least one provider key" is optional.
# ──────────────────────────────────────────────────────────────────────────

# --- model providers (BYOK) — set at least ONE ----------------------------
GEMINI_API_KEY=
OPENRO…KEY
DEEPSEEK_API_KEY=
***
# Later, just uncomment + add key + one entry in configs/providers.yaml:
# OPENAI_API_KEY=
*** ANTHROPIC_API_KEY=

*** --- server ---------------------------------------------------------------
OMI_HOST=127.0.0.1
OMI_PORT=8000
# Where per-task workspace copies live (safe to point at a scratch dir)
OMI_WORKSPACES_DIR=~/omi-workspaces
# Sandbox: auto | docker | local
OMI_SANDBOX=auto
OMI_SANDBOX_IMAGE=omiagent/runtime:local

# --- agent behavior --------------------------------------------------------
OMI_MAX_STEPS=80
OMI_STEP_TIMEOUT_S=120
OMI_TASK_BUDGET_USD=1.00
# Path to provider routing config (groups for the "max" model)
OMI_PROVIDERS_FILE=configs/providers.yaml

# --- gateway ---------------------------------------------------------------
# Optional bearer key protecting /v1/chat/completions (leave empty = open on localhost)
OMI_GATEWAY_KEY=
